{
  "name": "companion",
  "productName": "Companion",
  "version": "1.1.0",
  "description": "A desktop companion that keeps you company and reminds you to take breaks, drink water, and stay focused.",
  "author": "pradhan-not-found",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "homepage": "https://github.com/pradhan-not-found/Companion-",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "build-exe": "npm run dist:win"
  },
  "build": {
    "appId": "com.companion.desktop",
    "productName": "Companion",
    "copyright": "Copyright © 2026 pradhan-not-found",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      { "from": "build/icon.png", "to": "icon.png" },
      { "from": "build/tray-icon.png", "to": "tray-icon.png" },
      { "from": "build/trayTemplate.png", "to": "trayTemplate.png" },
      { "from": "pets", "to": "pets" }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Companion",
      "uninstallDisplayName": "Companion",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Companion-Setup-${version}-x64.${ext}"
    },
    "portable": {
      "artifactName": "Companion-${version}-x64-portable.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Companion uses Apple Events to read the active app and window title, so distraction detection can nudge you when blocked apps or keywords appear."
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pradhan-not-found",
        "repo": "Companion-"
      }
    ]
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  }
}
